#: incl/abilities.php:46
msgid "Actions provided by PublishPress plugins."
msgstr "A PublishPress bővítmények által biztosított műveletek."

#: incl/abilities.php:61
msgid "List PublishPress Block Types"
msgstr "PublishPress Blokk Típusok Listázása"

#: incl/abilities.php:62
msgid "Lists registered PublishPress Blocks block types and their editor metadata."
msgstr ""
"Regisztrált PublishPress Blokkok blokk típusa és szerkesztői metaadataik "
"listája."

#: incl/abilities.php:70
msgid "Get Block Configuration"
msgstr "Blokk Konfiguráció Lekérése"

#: incl/abilities.php:71
msgid ""
"Gets Extra Blocks saved defaults and available fields, including labels, "
"types, choices and ranges. Use these exact field names with "
"update-block-configuration. Defaults affect new blocks; existing post "
"blocks are unchanged."
msgstr ""
"Megkapja az Extra Blokkok mentett alapértelmezett értékeit és elérhető "
"mezőit, beleértve a címkéket, típusokat, választásokat és tartományokat. "
"Használja ezeket a pontos mezőneveket az update-block-configuration-hoz. Az "
"alapértelmezettek új blokkokra hatnak; a meglévő bejegyzés blokkok "
"változatlanok maradnak."

#: incl/abilities.php:79
msgid "List Block Control Presets"
msgstr "Blokkvezérlő Előbeállítások Listázása"

#: incl/abilities.php:80
msgid "Lists saved PublishPress Blocks visibility-control presets."
msgstr "Mentett PublishPress Blokkok láthatósági vezérlő előbeállításainak listája."

#: incl/abilities.php:88
msgid "List Custom Block Styles"
msgstr "Egyedi Blokk Stílusok Listázása"

#: incl/abilities.php:89
msgid "Lists saved PublishPress Blocks custom styles."
msgstr "Mentett PublishPress Blokkok egyedi stílusainak listája."

#: incl/abilities.php:97
msgid "List Auto Insert Rules"
msgstr "Automatikus Beillesztési Szabályok Listázása"

#: incl/abilities.php:98
msgid "Lists Auto Insert Block rules and their targeting metadata."
msgstr "Automatikus Beillesztési Blokk szabályok és célzási metaadataik listája."

#: incl/abilities.php:106
msgid "Inspect Post Blocks"
msgstr "Bejegyzés Blokkok Ellenőrzése"

#: incl/abilities.php:107
msgid ""
"Returns a compact, ordered inventory of blocks in one editable post "
"including attributes, but without rendered HTML. Does not expand synced "
"patterns or reusable block references."
msgstr ""
"Visszaad egy tömör, rendezett leltárt a blokkokról egy szerkeszthető "
"bejegyzésben, beleértve a tulajdonságokat, de rendered HTML nélkül. Nem "
"terjeszti ki a szinkronizált mintákat vagy újrafelhasználható blokk "
"hivatkozásokat."

