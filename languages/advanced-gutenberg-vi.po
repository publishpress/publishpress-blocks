#: incl/abilities.php:46
msgid "Actions provided by PublishPress plugins."
msgstr "Các hành động được cung cấp bởi các plugin PublishPress."

#: incl/abilities.php:61
msgid "List PublishPress Block Types"
msgstr "Danh sách các loại khối PublishPress"

#: incl/abilities.php:62
msgid "Lists registered PublishPress Blocks block types and their editor metadata."
msgstr ""
"Danh sách các loại khối PublishPress đã đăng ký và siêu dữ liệu biên tập "
"viên của chúng."

#: incl/abilities.php:70
msgid "Get Block Configuration"
msgstr "Lấy cấu hình khối"

#: incl/abilities.php:71
msgid ""
"Gets Extra Blocks saved defaults and available fields, including labels, "
"types, choices and ranges. Use these exact field names with "
"update-block-configuration. Defaults affect new blocks; existing post "
"blocks are unchanged."
msgstr ""
"Lấy các mặc định đã lưu của các khối bổ sung và các trường có sẵn, bao gồm "
"nhãn, loại, lựa chọn và phạm vi. Sử dụng chính xác các tên trường này với "
"update-block-configuration. Các mặc định ảnh hưởng đến các khối mới; các "
"khối bài viết hiện tại không thay đổi."

#: incl/abilities.php:79
msgid "List Block Control Presets"
msgstr "Danh sách các preset điều khiển khối"

#: incl/abilities.php:80
msgid "Lists saved PublishPress Blocks visibility-control presets."
msgstr "Danh sách các preset điều khiển hiển thị khối PublishPress đã lưu."

#: incl/abilities.php:88
msgid "List Custom Block Styles"
msgstr "Danh sách các kiểu khối tùy chỉnh"

#: incl/abilities.php:89
msgid "Lists saved PublishPress Blocks custom styles."
msgstr "Danh sách các kiểu tùy chỉnh khối PublishPress đã lưu."

#: incl/abilities.php:97
msgid "List Auto Insert Rules"
msgstr "Danh sách các quy tắc tự động chèn"

#: incl/abilities.php:98
msgid "Lists Auto Insert Block rules and their targeting metadata."
msgstr ""
"Danh sách các quy tắc chèn khối tự động và siêu dữ liệu nhắm mục tiêu của "
"chúng."

#: incl/abilities.php:106
msgid "Inspect Post Blocks"
msgstr "Kiểm tra các khối bài viết"

#: incl/abilities.php:107
msgid ""
"Returns a compact, ordered inventory of blocks in one editable post "
"including attributes, but without rendered HTML. Does not expand synced "
"patterns or reusable block references."
msgstr ""
"Trả về một danh sách ngắn gọn, có thứ tự các khối trong một bài viết có thể "
"chỉnh sửa, bao gồm các thuộc tính, nhưng không có HTML đã được render. "
"Không mở rộng các mẫu đồng bộ hoặc tham chiếu khối có thể tái sử dụng."

#: incl/abilities.php:330
#: incl/mcp/content.php:218
msgid "Post not found."
msgstr "Không tìm thấy bài viết."

